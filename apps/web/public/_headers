# Cabeceras de Netlify. Vive en public/ para quedar dentro de dist:
# así se aplican tanto al desplegar desde Git como al arrastrar la carpeta dist.

# Archivos con hash en el nombre: se pueden cachear para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# public/fonts no lleva hash en el nombre: 30 días, no "immutable".
/fonts/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
