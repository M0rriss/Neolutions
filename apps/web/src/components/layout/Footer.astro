---
import Container from "@/components/ui/Container.astro";
import IconBook from "@/components/ui/icons/IconBook.astro";
import IconFacebook from "@/components/ui/icons/IconFacebook.astro";
import IconTikTok from "@/components/ui/icons/IconTikTok.astro";
import IconWhatsApp from "@/components/ui/icons/IconWhatsApp.astro";
import { companyNav, helpNav, legalNav } from "@/data/navigation";
import { site } from "@/data/site";
import { shouldShow } from "@/lib/format";
import { getServices } from "@/lib/services";
import { whatsappLink } from "@/lib/whatsapp";
import Logo from "./Logo.astro";

const services = await getServices();
const columns = [
  {
    title: "Servicios",
    links: services.map((s) => ({ label: s.data.title, href: `/servicios/${s.id}` })),
  },
  { title: "Empresa", links: [...companyNav] },
  { title: "Asistencia", links: [...helpNav] },
];
const year = new Date().getFullYear();
const whatsapp = whatsappLink();
---

<footer class="footer">
  <Container>
    <div class="grid">
      <div class="brand">
        <a class="logo" href="/" aria-label="Neolutions, ir al inicio">
          <Logo />
        </a>
        <p class="tagline">{site.tagline}</p>
        <p>{site.area}</p>
        {shouldShow(site.schedule) && (
          <p class:list={{ todo: site.schedule.startsWith("TODO") }}>{site.schedule}</p>
        )}
        <div class="social">
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
            data-track="whatsapp_click"
            data-origen="footer"
          >
            <IconWhatsApp size={18} />
          </a>
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <IconFacebook size={18} />
          </a>
          <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
            <IconTikTok size={18} />
          </a>
        </div>
      </div>

      {columns.map((column) => (
        <details class="column" open data-footer-column>
          <summary>{column.title}</summary>
          <ul class="links">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <div class="cards">
      <a
        class="action"
        href={whatsapp}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
        data-origen="footer"
      >
        <IconWhatsApp size={26} />
        <span>
          <small>Escríbenos por</small>WhatsApp {site.whatsapp.display}
        </span>
      </a>
      <a class="action" href={site.social.tiktok} target="_blank" rel="noopener">
        <IconTikTok size={26} />
        <span>
          <small>Síguenos en</small>TikTok
        </span>
      </a>
      <a class="action" href={site.social.facebook} target="_blank" rel="noopener">
        <IconFacebook size={26} />
        <span>
          <small>Síguenos en</small>Facebook
        </span>
      </a>
      <a class="action" href="/legal/libro-de-reclamaciones">
        <IconBook size={26} />
        <span>
          <small>Registra tu reclamo</small>Libro de Reclamaciones
        </span>
      </a>
    </div>

    <p class="word" aria-hidden="true">
      Neolutions
    </p>

    <div class="bottom">
      <p>
        © {year} {site.name}. Todos los derechos reservados.
      </p>
      {site.legal.businessName && site.legal.ruc && (
        <p>
          {site.legal.businessName} · RUC {site.legal.ruc}
        </p>
      )}
      <ul class="legal">
        {legalNav.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</footer>

<script>
  // Plegadas en celular y abiertas desde 768px; sin JS quedan abiertas y accesibles.
  const narrow = window.matchMedia("(max-width: 767px)");
  const columns = document.querySelectorAll<HTMLDetailsElement>("[data-footer-column]");
  const sync = () => columns.forEach((column) => (column.open = !narrow.matches));
  sync();
  narrow.addEventListener("change", sync);
</script>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-9);
    overflow: hidden;
    background: linear-gradient(transparent, var(--color-footer-tint)), var(--color-brand-900);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
  }

  .brand {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    text-decoration: none;
  }

  .tagline {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--control-md);
    height: var(--control-md);
    border-radius: var(--radius-sm);
    background: var(--color-field);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .social a:hover {
    color: var(--color-accent-400);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: var(--control-md);
    color: var(--color-accent-400);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .links,
  .legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .links a:hover,
  .legal a:hover {
    color: var(--color-accent-400);
  }

  .cards {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .action {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-card);
    background: var(--gradient-card);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: border-color var(--transition-base);
  }

  .action:hover {
    border-color: var(--color-accent-500);
  }

  small {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  .word {
    position: relative;
    margin: var(--space-5) 0 var(--space-4);
    background: radial-gradient(
      48% 80% at 50% 62%,
      var(--color-accent-400),
      var(--color-footer-word) 62%,
      var(--color-brand-600) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 19.5vw, 15rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.03em;
    line-height: 1;
    text-align: center;
    user-select: none;
  }

  .word::before {
    content: "";
    position: absolute;
    inset: 10% 18% 0;
    z-index: -1;
    background: radial-gradient(closest-side, var(--color-accent-500), transparent);
    filter: blur(50px);
    opacity: 0.45;
  }

  .bottom {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1.6fr repeat(3, 1fr);
      gap: var(--space-6);
    }

    summary {
      cursor: default;
      pointer-events: none;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
