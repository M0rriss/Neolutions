---
import Button from "@/components/ui/Button.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { mainNav } from "@/data/navigation";
import { cleanPath } from "@/lib/seo";
import { getServices } from "@/lib/services";
import Logo from "./Logo.astro";
import MobileMenu from "./MobileMenu.astro";
import NavMenu from "./NavMenu.astro";

const services = await getServices();
const serviceLinks = services.map((s) => ({ label: s.data.title, href: `/servicios/${s.id}` }));
const current = cleanPath(Astro.url.pathname);
const items = mainNav.map((item, index) => ({
  ...item,
  id: `menu-${index}`,
  links: item.services ? serviceLinks : item.children ? [...item.children] : undefined,
}));
---

<header class="header" data-header>
  <div class="shell">
    <div class="bar">
      <a class="brand" href="/" aria-label="Neolutions, ir al inicio">
        <Logo />
      </a>
      <nav class="nav" aria-label="Principal">
        <ul>
          {items.map((item) => (
            <li>
              {item.links ? (
                <NavMenu id={item.id} label={item.label} items={item.links} />
              ) : (
                <a
                  class="link"
                  href={item.href}
                  aria-current={current === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="cta">
        <Button variant="secondary" href="/contacto">Contacto</Button>
        <WhatsAppButton label="Cotizar" origen="header" />
      </div>
      <div class="mobile">
        <MobileMenu />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const narrow = window.matchMedia("(max-width: 1023px)");
  let last = window.scrollY;
  let pointerY = Infinity;

  // Escritorio: al bajar se condensa; con el puntero arriba o el foco dentro vuelve completo.
  const updatePeek = () => {
    if (!header) return;
    const near = pointerY <= header.offsetHeight * 1.8;
    header.classList.toggle("is-peek", near || header.matches(":focus-within"));
  };

  // En celular se esconde al bajar y vuelve al subir, para no pisar el contenido.
  const update = () => {
    const y = window.scrollY;
    header?.classList.toggle("is-scrolled", y > 40);
    if (Math.abs(y - last) < 6) return;
    header?.classList.toggle("is-hidden", narrow.matches && y > last && y > 120);
    last = y;
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener(
    "pointermove",
    (event) => {
      pointerY = event.clientY;
      updatePeek();
    },
    { passive: true },
  );
  header?.addEventListener("focusin", updatePeek);
  header?.addEventListener("focusout", () => requestAnimationFrame(updatePeek));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    transition:
      transform 350ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color var(--transition-base);
  }

  .header.is-hidden {
    transform: translateY(-100%);
  }

  .shell {
    padding-inline: var(--header-padding-x);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
    transition: height 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    text-decoration: none;
  }

  .brand,
  .cta {
    transition:
      transform 400ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 350ms ease,
      visibility 350ms ease;
  }

  .nav,
  .cta {
    display: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: inline-flex;
    align-items: center;
    height: var(--nav-height);
    padding-inline: var(--nav-item-padding-x);
    color: var(--color-text-muted);
    font-size: var(--nav-font);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .link:hover,
  .link[aria-current="page"] {
    color: var(--color-text);
  }

  /* Fondo de vidrio mientras el header acompaña el scroll en celular */
  @media (max-width: 1023px) {
    .header.is-scrolled {
      background: var(--color-glass);
      backdrop-filter: blur(16px);
    }
  }

  @media (min-width: 1024px) {
    .nav,
    .cta {
      display: block;
    }

    .cta {
      display: flex;
      align-items: center;
      gap: var(--nav-cta-gap);
    }

    .cta :global(.btn) {
      min-height: var(--nav-cta-height);
      padding-block: 0;
      padding-inline: var(--nav-cta-padding-x);
      font-size: var(--nav-font);
    }

    .cta :global(.btn svg) {
      width: 1.1em;
      height: 1.1em;
    }

    .nav {
      position: absolute;
      left: 50%;
      padding-inline: var(--nav-padding-x);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--nav-radius);
      background: var(--gradient-glass), var(--color-glass-dark);
      box-shadow: var(--shadow-glass);
      backdrop-filter: blur(24px) saturate(1.8);
      transform: translateX(-50%);
      transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .is-scrolled:not(.is-peek) .bar {
      height: calc(var(--header-height) * 0.81);
    }

    .is-scrolled:not(.is-peek) .nav {
      transform: translateX(-50%) scale(0.92);
    }

    /* Resplandor que respira bajo el menú */
    .nav::before {
      content: "";
      position: absolute;
      inset: auto 14% -6px;
      height: 90%;
      border-radius: inherit;
      background: radial-gradient(closest-side, var(--color-accent-500), transparent);
      filter: blur(10px) brightness(1.5);
      opacity: 0.12;
      pointer-events: none;
      animation: nav-breathe 4s ease-in-out infinite alternate;
    }

    @keyframes nav-breathe {
      to {
        opacity: 0.3;
        transform: scale(1.3);
      }
    }

    .mobile {
      display: none;
    }

    .is-scrolled:not(.is-peek) .brand,
    .is-scrolled:not(.is-peek) .cta {
      opacity: 0;
      visibility: hidden;
    }

    .is-scrolled:not(.is-peek) .brand {
      transform: translateX(-1.275vw);
    }

    .is-scrolled:not(.is-peek) .cta {
      transform: translateX(1.275vw);
    }
  }
</style>
