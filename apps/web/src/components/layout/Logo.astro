---
// Logo oficial de Neolutions Tecnology. El SVG va en línea: el nombre usa
// currentColor (hereda el color del texto) y "Tecnology" el turquesa del logo.
// Fuente: src/assets/logo/neolutions.svg, generado desde el archivo del cliente.
import LogoSvg from "../../assets/logo/neolutions.svg";
---

<span class="logo">
  <LogoSvg aria-hidden="true" focusable="false" />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
  }

  .logo :global(svg) {
    display: block;
    width: auto;
    height: var(--logo-height);
  }
</style>
