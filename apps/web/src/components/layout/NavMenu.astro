---
import IconChevronDown from "@/components/ui/icons/IconChevronDown.astro";
import IconChevronRight from "@/components/ui/icons/IconChevronRight.astro";

interface Props {
  id: string;
  label: string;
  items: { label: string; href: string }[];
}
const { id, label, items } = Astro.props;
---

<div class="menu" data-nav-menu>
  <button class="trigger" type="button" aria-expanded="false" aria-controls={id}>
    {label}
    <span class="chevron">
      <IconChevronDown size={14} />
    </span>
  </button>
  <div class="panel" id={id}>
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href}>
            {item.label}
            <IconChevronRight size={14} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-nav-menu]").forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("button");
    const panel = menu.querySelector<HTMLElement>(".panel");
    if (!trigger || !panel) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("is-open", open);
    };

    // Enter y Espacio llegan como click por ser un <button> nativo.
    const isOpen = () => panel.classList.contains("is-open");
    trigger.addEventListener("click", () => setOpen(!isOpen()));
    menu.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") setOpen(true);
    });
    menu.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") setOpen(false);
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      setOpen(false);
      trigger.focus();
    });
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && !menu.contains(next)) setOpen(false);
    });
  });
</script>

<style>
  .menu {
    position: relative;
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--nav-item-gap);
    height: var(--nav-height);
    padding-inline: var(--nav-item-padding-x);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: var(--nav-font);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .trigger:hover,
  .trigger[aria-expanded="true"] {
    color: var(--color-text);
  }

  .chevron {
    display: flex;
    transition: transform var(--transition-fast);
  }

  .chevron :global(svg) {
    width: 1em;
    height: 1em;
  }

  .trigger[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .panel {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 1;
    min-width: max(11vw, 11rem);
    margin-top: 0.7vw;
    padding: 0.425vw;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--nav-radius);
    background:
      radial-gradient(120% 90% at 12% 0%, color-mix(in srgb, var(--color-accent-500) 16%, transparent), transparent 55%),
      var(--gradient-glass),
      var(--color-menu);
    box-shadow:
      rgba(255, 255, 255, 0.14) 0 1px 0 0 inset,
      rgba(0, 0, 0, 0.5) 0 16px 40px;
    backdrop-filter: blur(24px) saturate(1.8);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -0.4vw);
    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 250ms;
  }

  .panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  /* Puente invisible para que el mouse no cierre el panel al bajar */
  .panel::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--space-4)) 0 auto;
    height: var(--space-4);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.64vw 0.765vw;
    border-radius: 0.64vw;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--nav-submenu-font);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  a:hover {
    color: var(--color-text);
  }

  a :global(svg) {
    width: 1em;
    height: 1em;
    flex: none;
    opacity: 0.5;
  }
</style>
