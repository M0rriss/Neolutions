---
import Icon from "@/components/ui/Icon.astro";
import IconArrowRight from "@/components/ui/icons/IconArrowRight.astro";
import IconChevronDown from "@/components/ui/icons/IconChevronDown.astro";
import { serviceGroups } from "@/data/serviceGroups";
import { getServices } from "@/lib/services";

const services = await getServices();
---

<div class="menu" data-services-menu>
  <button class="trigger" type="button" aria-expanded="false" aria-controls="menu-servicios">
    Servicios
    <span class="chevron">
      <IconChevronDown size={16} />
    </span>
  </button>
  <div class="panel" id="menu-servicios" hidden>
    <div class="groups">
      {serviceGroups.map((group) => (
        <section class="group">
          <p class="group-title">{group.title}</p>
          <ul class="items">
            {services
              .filter((service) => service.data.group === group.id)
              .map((service) => (
                <li>
                  <a class="item" href={`/servicios/${service.id}`}>
                    <span class="item-icon">
                      <Icon name={service.data.icon} size={20} />
                    </span>
                    <span class="item-text">
                      <strong>{service.data.title}</strong>
                      <span>{service.data.tagline}</span>
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </div>
    <a class="all" href="/servicios">
      Ver todos los servicios
      <IconArrowRight size={16} />
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-services-menu]").forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("button");
    const panel = menu.querySelector<HTMLElement>(".panel");
    if (!trigger || !panel) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };

    // Enter y Espacio llegan como click por ser un <button> nativo.
    trigger.addEventListener("click", () => setOpen(panel.hidden !== false));

    menu.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") setOpen(true);
    });
    menu.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") setOpen(false);
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      setOpen(false);
      trigger.focus();
    });
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && !menu.contains(next)) setOpen(false);
    });
  });
</script>

<style>
  .menu {
    position: relative;
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--control-md);
    padding-inline: var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .trigger:hover,
  .trigger[aria-expanded="true"] {
    color: var(--color-text);
  }

  .chevron {
    display: flex;
    transition: transform var(--transition-fast);
  }

  .trigger[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .panel {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(40rem, calc(100vw - var(--space-7)));
    padding: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-brand-800);
    box-shadow: var(--shadow-card);
    transform: translateX(-50%);
  }

  .panel[hidden] {
    display: none;
  }

  /* Puente invisible para que el mouse no cierre el panel al bajar */
  .panel::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--space-3)) 0 auto;
    height: var(--space-3);
  }

  .groups {
    columns: 2;
    column-gap: var(--space-5);
  }

  .group {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }

  .group-title {
    margin-bottom: var(--space-2);
    padding-inline: var(--space-2);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .item:hover {
    background: var(--color-brand-700);
  }

  .item-icon {
    display: flex;
    flex: none;
    margin-top: var(--space-1);
    color: var(--color-accent-400);
  }

  .item-text {
    display: grid;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  strong {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }
</style>
