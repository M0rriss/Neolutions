---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import ParticleFigure from "@/components/ui/ParticleFigure.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { finalCta } from "@/data/home";

interface Props {
  service?: string;
}
const { service } = Astro.props;
---

<section class="section final">
  <Container>
    <div class="panel">
      <span class="dots" aria-hidden="true"></span>
      <div class="copy" data-rise>
        <h2 class="metal">{finalCta.title}</h2>
        <p>{finalCta.text}</p>
        <div class="actions">
          <WhatsAppButton service={service} origen="cta-final" />
          <Button variant="secondary" href="/contacto">
            {finalCta.secondary}
          </Button>
        </div>
      </div>
      <div class="forms">
        <ParticleFigure name="cpu" />
      </div>
    </div>
  </Container>
</section>

<style>
  .panel {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-8) var(--space-5) var(--space-6);
    overflow: hidden;
    border-radius: var(--radius-card);
    background:
      radial-gradient(
        22% 32% at 50% 104%,
        var(--color-mint),
        var(--color-accent-400) 34%,
        color-mix(in srgb, var(--color-accent-500) 50%, transparent) 62%,
        transparent 100%
      ),
      radial-gradient(
        38% 62% at 74% 40%,
        color-mix(in srgb, var(--color-accent-500) 7%, transparent),
        transparent 100%
      ),
      radial-gradient(
        18% 30% at 56% 96%,
        color-mix(in srgb, var(--color-accent-500) 30%, transparent),
        transparent 100%
      ),
      radial-gradient(
        28% 30% at 0% 0%,
        var(--color-accent-400),
        color-mix(in srgb, var(--color-accent-500) 40%, transparent) 45%,
        transparent 100%
      ),
      var(--color-panel);
  }

  /* Trama de puntos sobre la luz inferior */
  .dots {
    position: absolute;
    right: 42%;
    bottom: 0;
    left: 28%;
    height: 38%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.5) 1px, transparent 1.5px) 0 0 / 12px 12px;
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
    mask-image: radial-gradient(closest-side, #000, transparent);
    pointer-events: none;
  }

  .copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h2 {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
  }

  p {
    max-width: 30rem;
    color: var(--color-text-muted);
    font-size: var(--hero-text-size);
  }

  .actions {
    width: 100%;
  }

  .forms {
    width: 100%;
    height: 16rem;
  }

  @media (min-width: 1024px) {
    .final :global(.container) {
      max-width: none;
      padding-inline: 5vw;
    }

    .panel {
      display: flex;
      min-height: 45vw;
      padding: 3.4vw 4.25vw;
      border-radius: 1.4vw;
    }

    .copy {
      width: 46vw;
      gap: 1.2vw;
    }

    h2 {
      font-size: 4.78vw;
      line-height: 1.14;
    }

    p {
      font-size: max(0.956vw, 0.8125rem);
    }

    .actions :global(.btn) {
      min-height: var(--nav-cta-height);
      padding-block: 0;
      padding-inline: var(--nav-cta-padding-x);
      font-size: var(--nav-font);
    }

    .forms {
      position: absolute;
      top: 50%;
      right: 1.35vw;
      width: 39.6vw;
      height: 34vw;
      margin-top: -17vw;
    }
  }
</style>
