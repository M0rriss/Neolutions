---
import Container from "@/components/ui/Container.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { finalCta } from "@/data/home";

interface Props {
  service?: string;
}
const { service } = Astro.props;
---

<section class="section final">
  <Container>
    <div class="panel reveal">
      <div class="copy">
        <h2 class="metal">{finalCta.title}</h2>
        <p>{finalCta.text}</p>
        <div class="actions">
          <WhatsAppButton size="lg" service={service} origen="cta-final" />
          <a class="form" href="/contacto">
            {finalCta.secondary}
          </a>
        </div>
      </div>
      <canvas class="bars" data-bars aria-hidden="true"></canvas>
    </div>
  </Container>
</section>

<style>
  .panel {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
    min-height: 30rem;
    padding: var(--space-7) var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-card);
    background:
      radial-gradient(34rem 16rem at 42% 112%, var(--color-accent-400), transparent 70%),
      radial-gradient(22rem 18rem at 0% 0%, var(--color-accent-500), transparent 70%),
      var(--color-black);
  }

  .copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
  }

  p {
    max-width: 30rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    width: 100%;
  }

  .form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-md);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .bars {
    width: 100%;
    height: 14rem;
  }

  @media (min-width: 1024px) {
    .panel {
      grid-template-columns: 1.1fr 1fr;
      padding: var(--space-8);
    }

    .bars {
      height: 22rem;
    }
  }
</style>
