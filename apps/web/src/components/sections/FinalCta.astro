---
import Container from "@/components/ui/Container.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { finalCta } from "@/data/home";

interface Props {
  service?: string;
}
const { service } = Astro.props;
---

<section class="section final">
  <Container>
    <div class="panel-beam panel-beam--violet inner reveal">
      <h2 class="metal">{finalCta.title}</h2>
      <p>{finalCta.text}</p>
      <div class="actions">
        <WhatsAppButton size="lg" service={service} origen="cta-final" />
        <a class="form" href="/contacto">
          {finalCta.secondary}
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .final {
    position: relative;
    background: radial-gradient(50rem 26rem at 50% 30%, var(--color-violet-glow), transparent 70%);
  }

  .inner {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    padding: var(--space-8) var(--space-5);
    text-align: center;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-medium);
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    width: 100%;
    justify-content: center;
  }

  .form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-md);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
</style>
