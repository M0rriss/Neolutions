---
// Escena fija detrás de la portada. Sin WebGL o con movimiento reducido no se dibuja.
---

<div class="globe-stage" aria-hidden="true">
  <canvas data-scene></canvas>
</div>

<style>
  .globe-stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    contain: strict;
  }

  .globe-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-black);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  :global(.has-scene) .globe-stage::before {
    opacity: var(--scene-opacity, 0);
  }

  canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
