---
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { hero } from "@/data/home";
---

<section class="hero">
  <Container>
    <div class="copy">
      <Badge variant="status">{hero.badge}</Badge>
      <h1 class="metal" data-split>
        {hero.title}
      </h1>
      <p class="highlight">{hero.highlight}</p>
      <p class="text">{hero.text}</p>
      <div class="actions">
        <WhatsAppButton size="lg" origen="hero" />
        <Button variant="secondary" size="lg" href="#servicios">
          {hero.secondary}
        </Button>
      </div>
    </div>

    <img
      class="fallback"
      src="/images/hero/red-estatica.jpg"
      alt=""
      width="840"
      height="840"
      loading="lazy"
    />

    <div class="panel-beam console" aria-hidden="true">
      <picture>
        <source media="(min-width: 768px)" srcset="/images/dashboard/panel-escritorio.svg" />
        <img src="/images/dashboard/panel-movil.svg" alt="" width="319" height="576" />
      </picture>
    </div>
  </Container>
</section>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height));
    padding-top: calc(var(--header-height) + var(--space-6));
    /* Reserva el recorrido del parallax para que el panel no pise la sección siguiente */
    padding-bottom: var(--parallax-reserve);
    background: radial-gradient(
      70rem 30rem at 50% -8%,
      color-mix(in srgb, var(--color-accent-500) 26%, transparent),
      transparent 70%
    );
    text-align: center;
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--hero-title-size);
    font-weight: var(--weight-regular);
    /* El degradado recorta el texto a su caja: sin este aire se corta la g */
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    line-height: var(--hero-title-leading);
    letter-spacing: -0.02em;
  }

  .highlight {
    font-family: var(--font-display);
    color: var(--color-accent-400);
    font-size: var(--hero-highlight-size);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .text {
    max-width: 34em;
    color: var(--color-text-muted);
    font-size: var(--hero-text-size);
  }

  .actions {
    width: 100%;
    margin-top: var(--space-2);
  }

  .actions :global(.btn) {
    min-height: var(--hero-button-height);
    font-size: var(--hero-button-font);
  }

  .fallback {
    width: min(100%, 26rem);
    height: auto;
    margin: var(--space-6) auto 0;
  }

  :global(.has-scene) .fallback {
    visibility: hidden;
  }

  .console {
    width: var(--hero-frame-width);
    margin: var(--space-5) auto 0;
    overflow: hidden;
    border-width: var(--hero-frame-border);
    border-radius: var(--hero-frame-radius);
  }

  .console img {
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .actions {
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      position: relative;
    }

    .hero :global(.container) {
      max-width: none;
    }

    /* El texto ocupa hasta donde empieza el panel: misma altura relativa en toda pantalla */
    .copy {
      align-content: start;
      min-height: calc(var(--hero-frame-top) - var(--header-height) - var(--space-6));
    }

    .console {
      margin-top: 0;
      margin-inline: calc((100% - var(--hero-frame-width)) / 2);
    }

    .fallback {
      position: absolute;
      top: 42svh;
      left: 50%;
      width: auto;
      height: 34svh;
      margin: 0;
      object-fit: contain;
      transform: translateX(-50%);
    }

    :global(.has-scene) .fallback {
      opacity: 0;
    }
  }
</style>
