---
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { hero } from "@/data/home";
import { getServices } from "@/lib/services";

const preview = (await getServices()).slice(0, 4);
---

<section class="hero">
  <Container>
    <div class="copy">
      <Badge variant="status">{hero.badge}</Badge>
      <h1 class="metal" data-split>
        {hero.title}
      </h1>
      <p class="highlight">{hero.highlight}</p>
      <p class="text">{hero.text}</p>
      <div class="actions">
        <WhatsAppButton size="lg" origen="hero" />
        <Button variant="secondary" size="lg" href="#servicios">
          {hero.secondary}
        </Button>
      </div>
    </div>

    <img
      class="fallback"
      src="/images/hero/red-estatica.jpg"
      alt=""
      width="840"
      height="840"
      loading="lazy"
    />

    <div class="panel-beam console" aria-hidden="true">
      <div class="console-top">
        <span class="dot"></span>
        <span>{hero.consoleLabel}</span>
      </div>
      <ul class="rows">
        {preview.map((service) => (
          <li class="row">
            <span class="row-icon">
              <Icon name={service.data.icon} size={20} />
            </span>
            <span class="row-name">{service.data.title}</span>
            <span class="row-tag">{service.data.tagline}</span>
            <Badge variant="status">Disponible</Badge>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height));
    padding-top: calc(var(--header-height) + var(--space-6));
    background: radial-gradient(
      70rem 30rem at 50% -8%,
      color-mix(in srgb, var(--color-accent-500) 26%, transparent),
      transparent 70%
    );
    text-align: center;
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--weight-regular);
    letter-spacing: -0.02em;
  }

  .highlight {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .text {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    width: 100%;
    margin-top: var(--space-2);
  }

  .fallback {
    width: min(100%, 26rem);
    height: auto;
    margin: var(--space-6) auto 0;
  }

  :global(.has-scene) .fallback {
    visibility: hidden;
  }

  .console {
    margin-top: var(--space-5);
    text-align: left;
  }

  .console-top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-success);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .row-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--icon-circle);
    height: var(--icon-circle);
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-400);
  }

  .row-name {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .row-tag {
    display: none;
    flex: 1;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .actions {
      justify-content: center;
    }

    .row-tag {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .fallback {
      height: 23svh;
      width: auto;
      object-fit: contain;
    }

    :global(.has-scene) .fallback {
      opacity: 0;
    }
  }
</style>
