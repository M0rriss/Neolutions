---
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { hero } from "@/data/home";
import { getServices } from "@/lib/services";
import TrustBar from "./TrustBar.astro";

const preview = (await getServices()).slice(0, 4);
---

<section class="hero">
  <Container>
    <div class="grid">
      <div class="copy">
        <Badge variant="status">{hero.badge}</Badge>
        <h1>{hero.title}</h1>
        <p class="highlight">{hero.highlight}</p>
        <p class="text">{hero.text}</p>
        <div class="actions">
          <WhatsAppButton size="lg" origen="hero" />
          <Button variant="secondary" size="lg" href="#servicios">
            {hero.secondary}
          </Button>
        </div>
        <TrustBar />
      </div>

      <div class="visual" aria-hidden="true">
        <div class="console">
          <div class="console-top">
            <span class="dot"></span>
            <span>{hero.consoleLabel}</span>
          </div>
          <ul class="rows">
            {preview.map((service) => (
              <li class="row">
                <span class="row-icon">
                  <Icon name={service.data.icon} size={20} />
                </span>
                <span class="row-name">{service.data.title}</span>
                <Badge variant="status">Disponible</Badge>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + var(--space-5)) var(--space-8);
    overflow: hidden;
    background:
      radial-gradient(60rem 40rem at 85% 20%, var(--color-accent-100), transparent 65%),
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / var(--space-8) var(--space-8),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / var(--space-8)
        var(--space-8),
      var(--color-brand-800);
    background-blend-mode: normal, soft-light, soft-light, normal;
  }

  .grid {
    display: grid;
    gap: var(--space-7);
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h1 {
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .highlight {
    color: var(--color-accent-400);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .text {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    width: 100%;
    margin-block: var(--space-2);
  }

  .console {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-brand-700);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .console-top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-success);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--icon-circle);
    height: var(--icon-circle);
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-400);
  }

  .row-name {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: calc(100svh - var(--announcement-height));
      display: flex;
      align-items: center;
    }

    .grid {
      grid-template-columns: 55fr 45fr;
      align-items: center;
    }
  }
</style>
