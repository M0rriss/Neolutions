---
import Badge from "@/components/ui/Badge.astro";
import Container from "@/components/ui/Container.astro";

interface Props {
  badge?: string;
  title: string;
  text?: string;
  /** Panel debajo del título, igual que en la portada */
  image?: string;
}
const { badge, title, text, image } = Astro.props;
---

<section class="hero">
  <Container>
    <div class="copy">
      {badge && <Badge variant="status">{badge}</Badge>}
      <h1 class="metal" data-split>
        {title}
      </h1>
      {text && <p class="text">{text}</p>}
      <div class="slot">
        <slot />
      </div>
    </div>
    {image && (
      <div class="panel-beam frame mock" aria-hidden="true">
        <img src={image} alt="" width="1030" height="539" />
      </div>
    )}
    <slot name="after" />
  </Container>
</section>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + var(--space-7)) var(--space-7);
    background: var(--gradient-top-glow);
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    font-size: var(--hero-title-size);
    font-weight: var(--weight-regular);
    line-height: var(--hero-title-leading);
  }

  .text {
    color: var(--color-text-muted);
    font-size: var(--hero-text-size);
  }

  .slot {
    width: 100%;
  }

  .slot :global(.actions) {
    justify-content: center;
  }

  .slot :global(.btn) {
    min-height: var(--hero-button-height);
    font-size: var(--hero-button-font);
  }

  .frame {
    width: var(--hero-frame-width);
    margin: var(--space-7) auto 0;
    overflow: hidden;
    border-width: var(--hero-frame-border);
    border-radius: var(--hero-frame-radius);
  }

  .frame img {
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .hero :global(.container) {
      max-width: none;
    }

    .frame {
      margin-inline: calc((100% - var(--hero-frame-width)) / 2);
    }
  }
</style>
