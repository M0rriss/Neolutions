---
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { processSection } from "@/data/home";
import { processSteps } from "@/data/process";

interface Props {
  service?: string;
}
const { service } = Astro.props;
---

<section class="process" id="g-process">
  <Container>
    <div class="layout">
      <div class="copy">
        <Badge variant="status">{processSection.eyebrow}</Badge>
        <h2 class="metal">{processSection.title}</h2>
        <p class="intro">{processSection.text}</p>
        <div class="actions">
          <WhatsAppButton service={service} origen="proceso" />
          <Button variant="secondary" href="/servicios">
            {processSection.secondary}
          </Button>
        </div>
      </div>
      <div class="steps">
        <span class="rail" aria-hidden="true" data-rail></span>
        <ol class="list">
          {processSteps.map((step, index) => (
            <li class="step" data-step>
              <span class="number" aria-hidden="true">
                {index + 1}
              </span>
              <p class="label">{step.label}</p>
              <h3>{step.title}</h3>
              <p class="text">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Container>
</section>

<style>
  .process {
    position: relative;
    padding-block: var(--section-padding-y);
  }

  .layout {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h2 {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
  }

  .intro {
    color: var(--color-text-muted);
    font-size: var(--hero-text-size);
  }

  .actions {
    width: 100%;
  }

  .steps {
    position: relative;
  }

  /* En pantallas angostas el planeta pasa entre el texto y los pasos */
  @media (max-width: 1023px) {
    .layout {
      gap: 66vw;
    }
  }

  .list {
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Riel: dos degradados en uno. Una banda clara corre sobre la base oscura;
     el scroll solo mueve --band. */
  .steps {
    --marker: 1.5rem;
    --rail: 1.75rem;
    --band: 40%;
  }

  .rail {
    position: absolute;
    top: 0;
    bottom: 3.5rem;
    left: 0;
    width: var(--rail);
    border-radius: var(--radius-pill);
    background:
      linear-gradient(
        transparent calc(var(--band) - 14%),
        color-mix(in srgb, var(--color-mint) 80%, transparent) calc(var(--band) - 2%),
        color-mix(in srgb, var(--color-mint) 80%, transparent) calc(var(--band) + 2%),
        transparent calc(var(--band) + 14%)
      ),
      linear-gradient(var(--color-rail-top), var(--color-rail-mid) 55%, var(--color-rail-end));
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding-left: calc(var(--rail) + var(--space-4));
  }

  .number {
    position: absolute;
    top: 0;
    left: calc((var(--rail) - var(--marker)) / 2);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--marker);
    height: var(--marker);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #ffffff, #d7dae0);
    box-shadow: 0 0 calc(10px + var(--glow, 0) * 18px) calc(1px + var(--glow, 0) * 5px)
      color-mix(in srgb, var(--color-accent-500) calc(35% + var(--glow, 0) * 50%), transparent);
    color: var(--color-brand-900);
    font-size: var(--text-sm);
    line-height: 1;
  }

  .label {
    color: var(--color-accent-400);
    font-size: var(--text-sm);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
  }

  .text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  @media (min-width: 1024px) {
    .process {
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-block: 0;
    }

    .process :global(.container) {
      max-width: none;
      padding-inline: 5vw;
    }

    .layout {
      grid-template-columns: 29vw minmax(0, 1fr) 25.5vw;
    }

    .copy {
      grid-column: 1;
      gap: 1.25vw;
    }

    .intro {
      max-width: 23vw;
      font-size: max(0.956vw, 0.8125rem);
      line-height: 1.4;
    }

    .actions :global(.btn) {
      min-height: var(--nav-cta-height);
      padding-block: 0;
      padding-inline: var(--nav-cta-padding-x);
      font-size: var(--nav-font);
    }

    .steps {
      --marker: 1.84vw;
      --rail: 2.125vw;
      grid-column: 3;
    }

    .rail {
      bottom: 3.6vw;
    }

    .list {
      gap: 5.5vw;
    }

    .step {
      gap: 0.35vw;
      padding-left: 3.6vw;
    }

    .number {
      font-size: 1.0625vw;
    }

    .label {
      font-size: 0.956vw;
    }

    h3 {
      font-size: 1.275vw;
    }

    .text {
      font-size: max(0.85vw, 0.75rem);
    }

    /* Sin globo detrás (páginas de servicio) la columna central sobra */
    :global(body:not(:has(.globe-stage))) .layout {
      grid-template-columns: minmax(0, 1fr) 25.5vw;
    }

    :global(body:not(:has(.globe-stage))) .steps {
      grid-column: 2;
    }
  }
</style>
