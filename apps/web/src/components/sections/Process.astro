---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { processSection } from "@/data/home";
import { processSteps } from "@/data/process";

interface Props {
  service?: string;
}
const { service } = Astro.props;
---

<section class="section section--deep">
  <Container>
    <div class="reveal">
      <SectionHeading eyebrow={processSection.eyebrow} title={processSection.title} />
    </div>
    <ol class="steps reveal">
      {processSteps.map((step, index) => (
        <li class="step">
          <span class="number" aria-hidden="true">
            {index + 1}
          </span>
          <p class="label">{step.label}</p>
          <h3>{step.title}</h3>
          <p class="text">{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="actions cta">
      <WhatsAppButton size="lg" service={service} origen="proceso" />
    </div>
  </Container>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }

  /* El "cable" que une los pasos, con una señal que lo recorre */
  .steps::before {
    content: "";
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: calc(var(--control-lg) / 2);
    width: 1px;
    background: var(--color-border-strong);
  }

  .steps::after {
    content: "";
    position: absolute;
    top: var(--space-5);
    left: calc(var(--control-lg) / 2 - 2px);
    width: 5px;
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-400);
    box-shadow: var(--shadow-accent);
    animation: signal-y 7s linear infinite;
  }

  @keyframes signal-y {
    to {
      top: calc(100% - var(--space-5));
    }
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding-left: calc(var(--control-lg) + var(--space-4));
    min-height: var(--control-lg);
  }

  .number {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--control-lg);
    height: var(--control-lg);
    border: 2px solid var(--color-accent-500);
    border-radius: var(--radius-pill);
    background: var(--color-brand-900);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }

  .label {
    color: var(--color-accent-400);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .text {
    color: var(--color-text-muted);
  }

  .cta {
    margin-top: var(--space-7);
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }

    .steps::before {
      top: calc(var(--control-lg) / 2);
      right: var(--space-8);
      bottom: auto;
      left: var(--control-lg);
      width: auto;
      height: 1px;
    }

    .steps::after {
      top: calc(var(--control-lg) / 2 - 2px);
      left: var(--control-lg);
      animation-name: signal-x;
    }

    @keyframes signal-x {
      to {
        left: calc(100% - var(--space-8));
      }
    }

    .step {
      padding-top: calc(var(--control-lg) + var(--space-4));
      padding-left: 0;
    }
  }
</style>
