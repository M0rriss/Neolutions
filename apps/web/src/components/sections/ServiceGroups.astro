---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import IconCheck from "@/components/ui/icons/IconCheck.astro";
import { groupsSection } from "@/data/home";
import { serviceGroups } from "@/data/serviceGroups";
import { getServices } from "@/lib/services";

const services = await getServices();
const featured = Math.floor(serviceGroups.length / 2);
---

<section class="section">
  <Container>
    <div class="reveal">
      <SectionHeading eyebrow={groupsSection.eyebrow} title={groupsSection.title} align="center" />
    </div>
    <div class="grid">
      {serviceGroups.map((group, index) => (
        <article
          class:list={[
            "plan reveal",
            { "panel-beam": index === featured, "plan--featured": index === featured },
          ]}
        >
          <span class="corner" aria-hidden="true" />
          <div class="head">
            <h3>{group.title}</h3>
            <p>{group.description}</p>
          </div>
          <div class="buttons">
            <WhatsAppButton
              message={group.whatsappMessage}
              label={groupsSection.quote}
              origen="bloque"
            />
            <Button variant="secondary" href={`/servicios#${group.id}`}>
              {groupsSection.see}
            </Button>
          </div>
          <ul class="links">
            {services
              .filter((service) => service.data.group === group.id)
              .map((service) => (
                <li>
                  <a href={`/servicios/${service.id}`}>
                    <span class="check">
                      <IconCheck size={14} />
                    </span>
                    {service.data.title}
                  </a>
                </li>
              ))}
          </ul>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow: hidden;
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-black);
    transition: border-color var(--transition-base);
  }

  .plan:hover {
    border-color: var(--color-card-border-solid);
  }

  .plan--featured {
    overflow: visible;
    border: 6px solid var(--color-card-border);
  }

  /* Luz verde que baja desde la esquina superior */
  .corner {
    position: absolute;
    top: -6rem;
    right: 10%;
    width: 12rem;
    height: 16rem;
    background: var(--color-accent-500);
    filter: blur(70px);
    opacity: 0.14;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .plan:hover .corner {
    opacity: 0.3;
  }

  .head,
  .buttons,
  .links {
    position: relative;
  }

  .head {
    display: grid;
    gap: var(--space-3);
    min-height: 9rem;
    align-content: start;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
  }

  .head p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .buttons {
    display: grid;
    gap: var(--space-2);
  }

  .buttons > :global(*) {
    width: 100%;
  }

  .links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .links a:hover {
    color: var(--color-accent-400);
  }

  .check {
    display: flex;
    color: var(--color-accent-400);
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
