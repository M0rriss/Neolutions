---
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import { gridSection } from "@/data/home";
import { getServices } from "@/lib/services";

const services = await getServices();
const middle = Math.floor(services.length / 2);
const columns = [services.slice(0, middle), services.slice(middle, services.length - 1)];
const last = services.at(-1);
---

<section class="section grid-section" id="g-services">
  <Container>
    <h2 class="metal" data-split>
      {gridSection.title}
    </h2>
    <div class="layout">
      {columns.map((column, side) => (
        <ul class="column">
          {column.map((service) => (
            <li class="reveal" data-slide={side === 0 ? "left" : "right"}>
              <a class="tile" data-group={service.data.group} href={`/servicios/${service.id}`}>
                <span class="icon">
                  <Icon name={service.data.icon} size={24} />
                </span>
                <span class="body">
                  <strong>{service.data.title}</strong>
                  <span>{service.data.tagline}</span>
                  <em>{gridSection.more}</em>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ))}
      {last && (
        <a
          class="tile tile--center reveal"
          data-group={last.data.group}
          href={`/servicios/${last.id}`}
        >
          <span class="icon">
            <Icon name={last.data.icon} size={24} />
          </span>
          <span class="body">
            <strong>{last.data.title}</strong>
            <span>{last.data.tagline}</span>
            <em>{gridSection.more}</em>
          </span>
        </a>
      )}
    </div>
  </Container>
</section>

<style>
  h2 {
    margin-bottom: var(--space-7);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-heading);
    text-align: center;
  }

  .layout {
    display: grid;
    gap: var(--space-4);
  }

  .column {
    display: grid;
    gap: var(--space-4);
    /* Filas iguales y arriba: las dos columnas quedan alineadas */
    grid-auto-rows: 1fr;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .column li {
    display: grid;
  }

  /* Cristal real: fondo casi transparente, desenfoque y brillo en la esquina */
  .tile {
    --tint: var(--color-accent-400);
    position: relative;
    display: flex;
    gap: var(--space-4);
    height: 9.75rem;
    overflow: hidden;
    padding: var(--space-5) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--tint) 26%, transparent);
    border-radius: var(--radius-card);
    background: var(--color-glass-card);
    backdrop-filter: blur(24px);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 350ms ease;
  }

  .tile::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 28%;
    aspect-ratio: 1;
    background: var(--tint);
    filter: blur(45px);
    opacity: 0.3;
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  .tile:hover {
    border-color: color-mix(in srgb, var(--tint) 60%, transparent);
  }

  .tile:hover::before {
    opacity: 0.5;
  }

  .tile[data-group="seguridad"] {
    --tint: var(--color-warning);
  }

  .tile[data-group="desarrollo-digital"] {
    --tint: var(--color-violet-400);
  }

  .icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--control-md);
    height: var(--control-md);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--tint) 16%, transparent);
    color: var(--tint);
  }

  .body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  strong {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
    white-space: nowrap;
  }

  /* Siempre dos líneas como máximo: el botón cae en el mismo sitio en todas */
  .body span {
    display: -webkit-box;
    margin-top: var(--space-1);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  em {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    margin-top: auto;
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    background: linear-gradient(transparent, color-mix(in srgb, var(--tint) 38%, transparent));
    color: var(--color-text);
    font-size: var(--text-xs);
    font-style: normal;
    transition: box-shadow 350ms ease;
  }

  .tile:hover em {
    box-shadow: 0 6px 16px -6px var(--tint);
  }

  @media (min-width: 1024px) {
    .grid-section {
      display: flex;
      align-items: center;
      min-height: 100svh;
    }

    .grid-section :global(.container) {
      max-width: none;
      padding-inline: 9.25vw;
    }

    h2 {
      max-width: 44vw;
      margin: 0 auto 2.2vw;
      line-height: 1;
    }

    .layout {
      grid-template-columns: 22.1vw minmax(0, 1fr) 22.1vw;
      grid-template-areas: "left center right" "bottom bottom bottom";
      gap: 1.275vw;
    }

    .column {
      gap: 1.275vw;
    }

    .column:first-child {
      grid-area: left;
    }

    .column:nth-child(2) {
      grid-area: right;
    }

    .tile {
      gap: 1.45vw;
      height: 10.4vw;
      padding: 1.65vw 1.2vw 1.45vw 1.6vw;
      border-radius: 1.6vw;
    }

    .icon {
      width: 3.45vw;
      height: 3.45vw;
      border-radius: 0.72vw;
    }

    .icon :global(svg) {
      width: 55%;
      height: 55%;
    }

    .body {
      font-size: 0.85vw;
    }

    strong {
      font-size: 1.13vw;
    }

    em {
      height: 2.34vw;
      padding-inline: 1.36vw;
      font-size: 0.85vw;
    }

    .tile--center {
      grid-area: bottom;
      justify-self: center;
      width: 22.1vw;
    }
  }
</style>
