---
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import { gridSection } from "@/data/home";
import { getServices } from "@/lib/services";

const services = await getServices();
const middle = Math.floor(services.length / 2);
const columns = [services.slice(0, middle), services.slice(middle, services.length - 1)];
const last = services.at(-1);
---

<section class="section grid-section" id="g-services">
  <Container>
    <h2 class="metal" data-split>
      {gridSection.title}
    </h2>
    <div class="layout">
      {columns.map((column, side) => (
        <ul class="column">
          {column.map((service) => (
            <li class="reveal" data-slide={side === 0 ? "left" : "right"}>
              <a class="tile" data-group={service.data.group} href={`/servicios/${service.id}`}>
                <span class="icon">
                  <Icon name={service.data.icon} size={24} />
                </span>
                <span class="body">
                  <strong>{service.data.title}</strong>
                  <span>{service.data.tagline}</span>
                  <em>{gridSection.more}</em>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ))}
      {last && (
        <a
          class="tile tile--center reveal"
          data-group={last.data.group}
          href={`/servicios/${last.id}`}
        >
          <span class="icon">
            <Icon name={last.data.icon} size={24} />
          </span>
          <span class="body">
            <strong>{last.data.title}</strong>
            <span>{last.data.tagline}</span>
            <em>{gridSection.more}</em>
          </span>
        </a>
      )}
    </div>
  </Container>
</section>

<style>
  .title {
    max-width: 44rem;
    margin: 0 auto var(--space-7);
    text-align: center;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
  }

  .layout {
    display: grid;
    gap: var(--space-4);
  }

  .column {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    --tint: var(--color-accent-400);
    position: relative;
    display: flex;
    gap: var(--space-4);
    overflow: hidden;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-bottom-color: color-mix(in srgb, var(--tint) 45%, transparent);
    border-radius: var(--radius-card);
    background: var(--color-glass-card);
    backdrop-filter: blur(24px);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition-base);
  }

  /* Resplandor de color en la esquina */
  .tile::before {
    content: "";
    position: absolute;
    top: -3rem;
    right: -2.5rem;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    background: var(--tint);
    filter: blur(44px);
    opacity: 0.22;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .tile:hover::before {
    opacity: 0.42;
  }

  .tile[data-group="seguridad"] {
    --tint: var(--color-warning);
  }

  .tile[data-group="desarrollo-digital"] {
    --tint: var(--color-violet-400);
  }

  .tile:hover {
    border-color: color-mix(in srgb, var(--tint) 70%, transparent);
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--control-lg);
    height: var(--control-lg);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--tint) 16%, transparent);
    color: var(--tint);
  }

  .body {
    position: relative;
    display: grid;
    gap: var(--space-1);
    justify-items: start;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  strong {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  em {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tint) 22%, transparent);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-style: normal;
    font-weight: var(--weight-semibold);
    transition: background-color var(--transition-base);
  }

  .tile:hover em {
    background: color-mix(in srgb, var(--tint) 40%, transparent);
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 26rem) minmax(0, 1fr);
      grid-template-areas: "left center right" "left bottom right";
      min-height: 38rem;
    }

    .column:first-child {
      grid-area: left;
    }

    .column:nth-child(2) {
      grid-area: right;
    }

    .tile--center {
      grid-area: bottom;
      align-self: end;
    }
  }
</style>
