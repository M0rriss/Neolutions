---
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import IconArrowRight from "@/components/ui/icons/IconArrowRight.astro";
import IconChevronRight from "@/components/ui/icons/IconChevronRight.astro";
import { servicesSection } from "@/data/home";
import { serviceGroups } from "@/data/serviceGroups";
import { getServices, groupTitle } from "@/lib/services";

interface Props {
  /** En /servicios no hace falta el enlace a sí misma */
  showAllLink?: boolean;
  /** La portada muestra la tabla sola; /servicios conserva los filtros */
  showFilters?: boolean;
}

const { showAllLink = true, showFilters = true } = Astro.props;
const services = await getServices();
const filters = [{ id: "todos", title: "Todos" }, ...serviceGroups];
---

<section class="section" id="servicios">
  <Container>
    <div class="reveal">
      <SectionHeading
        eyebrow={servicesSection.eyebrow}
        title={servicesSection.title}
        subtitle={servicesSection.subtitle}
        align="center"
      />
    </div>

    {showFilters && (
      <div class="filters" role="tablist" aria-label="Filtrar servicios" data-filters>
        {filters.map((filter, index) => (
          <button
            class="filter"
            type="button"
            role="tab"
            id={`filtro-${filter.id}`}
            aria-controls="tabla-servicios"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-filter={filter.id}
          >
            {filter.title}
          </button>
        ))}
      </div>
    )}

    <div
      class="panel-beam board"
      id="tabla-servicios"
      role={showFilters ? "tabpanel" : undefined}
      aria-labelledby={showFilters ? "filtro-todos" : undefined}
      data-filter-panel
    >
      <table class="table" role="table" aria-label="Servicios de Neolutions">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Servicio</th>
            <th role="columnheader" scope="col">Para quién</th>
            <th role="columnheader" scope="col">Incluye</th>
            <th role="columnheader" scope="col">Estado</th>
            <th role="columnheader" scope="col">Bloque</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {services.map((service) => (
            <tr class="row reveal" role="row" data-group={service.data.group}>
              <th class="cell-service" role="rowheader" scope="row">
                <span class="icon">
                  <Icon name={service.data.icon} size={18} />
                </span>
                <a class="name" href={`/servicios/${service.id}`}>
                  <span class="title">{service.data.title}</span>
                  <span class="tagline">{service.data.tagline}</span>
                </a>
              </th>
              <td class="cell-audience" role="cell">
                {service.data.audienceShort}
              </td>
              <td class="cell-includes" role="cell">
                {service.data.includesShort}
              </td>
              <td class="cell-state" role="cell">
                {service.data.available && (
                  <span class="state">
                    <span class="dot"></span>Disponible
                  </span>
                )}
              </td>
              <td class="cell-group" role="cell">
                <span>{groupTitle(service.data.group)}</span>
                <IconChevronRight size={14} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="note">{servicesSection.note}</p>
    {showAllLink && (
      <a class="all" href="/servicios">
        {servicesSection.all}
        <IconArrowRight size={18} />
      </a>
    )}
  </Container>
</section>

<script>
  const tablist = document.querySelector<HTMLElement>("[data-filters]");
  const panel = document.querySelector<HTMLElement>("[data-filter-panel]");

  if (tablist && panel) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const rows = [...panel.querySelectorAll<HTMLElement>("[data-group]")];

    const select = (tab: HTMLButtonElement) => {
      for (const item of tabs) {
        const active = item === tab;
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      }
      panel.setAttribute("aria-labelledby", tab.id);
      const filter = tab.dataset.filter;
      for (const row of rows) {
        row.hidden = filter !== "todos" && row.dataset.group !== filter;
        // Una fila oculta al cargar no recibe su entrada: se muestra directo.
        if (!row.hidden) row.style.opacity = "1";
      }
    };

    // Los enlaces del menú llegan como /servicios#<bloque>
    const fromHash = tabs.find((tab) => tab.dataset.filter === location.hash.slice(1));
    if (fromHash) {
      select(fromHash);
      document.querySelector("#servicios")?.scrollIntoView();
    }

    tablist.addEventListener("click", (event) => {
      const tab = event.target instanceof Element && event.target.closest("[role=tab]");
      if (tab) select(tab as HTMLButtonElement);
    });

    tablist.addEventListener("keydown", (event) => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const moves: Record<string, number> = {
        ArrowRight: (index + 1) % tabs.length,
        ArrowLeft: (index - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const next = moves[event.key];
      if (index < 0 || next === undefined) return;
      event.preventDefault();
      tabs[next].focus();
      select(tabs[next]);
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
  }

  .filter {
    min-height: var(--control-md);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .filter:hover {
    color: var(--color-text);
  }

  .filter[aria-selected="true"] {
    border-color: var(--color-accent-500);
    background: var(--color-accent-500);
    color: var(--color-text-on-accent);
  }

  /* Panel con degradado vertical y filas separadas por una línea muy tenue */
  .board {
    padding: 0 var(--space-3);
    border-width: 1px;
    background: linear-gradient(var(--color-table-top), var(--color-table-base));
  }

  .table {
    display: block;
    width: 100%;
  }

  thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  tbody {
    display: grid;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--color-divider);
    transition: background-color var(--transition-base);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row:hover {
    background: var(--color-accent-100);
  }

  .row[hidden] {
    display: none;
  }

  .row th,
  .row td {
    display: block;
    padding: 0;
    font-weight: var(--weight-regular);
    text-align: left;
  }

  .row .cell-service {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-400);
  }

  .name {
    display: grid;
    color: var(--color-text);
    text-decoration: none;
  }

  /* Toda la fila funciona como enlace */
  .name::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .title {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .tagline {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .cell-audience,
  .cell-includes {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cell-audience {
    display: none !important;
  }

  .cell-state {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.02);
    color: var(--color-text);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-400);
  }

  .cell-group {
    display: flex !important;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .note {
    margin-top: var(--space-5);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    text-align: center;
  }

  .all {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .table {
      display: table;
      border-collapse: collapse;
    }

    thead {
      display: none;
    }

    tbody {
      display: table-row-group;
    }

    .row {
      display: table-row;
    }

    .row[hidden] {
      display: none;
    }

    .row th,
    .row td {
      display: table-cell;
      padding: 1.19vw var(--space-3);
      vertical-align: middle;
    }

    .row .cell-service {
      display: table-cell;
    }

    .cell-service .icon {
      float: left;
      margin-right: var(--space-3);
    }

    .cell-group {
      display: table-cell !important;
      text-align: right !important;
      white-space: nowrap;
    }

    .cell-group :global(svg) {
      display: inline;
      margin-left: var(--space-2);
      vertical-align: -2px;
    }

    .cell-audience {
      display: none !important;
    }
  }

  @media (min-width: 1024px) {
    /* La tabla ocupa casi toda la pantalla */
    .section :global(.container) {
      max-width: none;
      padding-inline: 5vw;
    }

    .board {
      padding: 0 1.7vw;
      border-radius: 1.4vw;
    }

    .table {
      table-layout: fixed;
    }

    .row th,
    .row td {
      padding: 1.5vw 1vw;
    }

    .row .cell-service {
      width: 27%;
    }

    .cell-audience {
      display: table-cell !important;
      width: 20%;
    }

    .cell-includes {
      width: 25%;
    }

    .cell-state {
      width: 10%;
    }

    .cell-group {
      width: 18%;
    }

    .cell-service .icon {
      width: 2.9vw;
      height: 2.9vw;
      margin-right: 1.1vw;
    }

    .cell-service .icon :global(svg) {
      width: 50%;
      height: 50%;
    }

    .title {
      font-size: 1.25vw;
    }

    .tagline {
      font-size: max(0.8vw, 0.6875rem);
    }

    .cell-audience,
    .cell-includes {
      font-size: max(0.95vw, 0.75rem);
    }

    .cell-group {
      font-size: max(0.85vw, 0.6875rem);
    }

    .state {
      font-size: max(0.8vw, 0.6875rem);
    }

    .note {
      font-size: max(0.85vw, 0.6875rem);
    }
  }
</style>
