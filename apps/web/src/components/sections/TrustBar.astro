---
import { trustItems } from "@/data/trust";
import { isPending, shouldShow } from "@/lib/format";

const items = trustItems.filter((item) => shouldShow(item.value));
---

<dl class="trust">
  {items.map((item) => (
    <div class:list={["item", { todo: isPending(item.value) }]}>
      <dt>{item.label}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .trust {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  dd {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  @media (min-width: 768px) {
    .trust {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4) 0;
    }

    .item {
      padding-inline: var(--space-5);
      border-left: 1px solid var(--color-border);
    }

    .item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
