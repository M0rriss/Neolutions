---
import Container from "@/components/ui/Container.astro";
import { statsSection } from "@/data/home";
import { trustItems } from "@/data/trust";
import { isPending, shouldShow } from "@/lib/format";

const items = trustItems.filter((item) => shouldShow(item.value));
---

<section class="stats" id="g-stats">
  <Container>
    <h2 class="metal" data-split>{statsSection.title}</h2>
    <dl class="grid">
      {
        items.map((item) => {
          const count = /^\d+$/.test(item.value) ? item.value : undefined;
          return (
            <div class:list={["item reveal", { todo: isPending(item.value) }]}>
              <dt>{item.label}</dt>
              <dd data-count={count}>{item.value}</dd>
            </div>
          );
        })
      }
    </dl>
  </Container>
</section>

<style>
  .stats {
    padding-block: var(--section-padding-y);
    text-align: center;
  }

  h2 {
    margin-bottom: var(--space-7);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-medium);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    max-width: 60rem;
    margin-inline: auto;
  }

  .item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-glass);
    backdrop-filter: blur(6px);
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  dd {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }
</style>
