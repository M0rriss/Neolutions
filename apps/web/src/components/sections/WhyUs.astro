---
import Container from "@/components/ui/Container.astro";
import IconWhatsApp from "@/components/ui/icons/IconWhatsApp.astro";
import { finalCta, whySection } from "@/data/home";
import { site } from "@/data/site";
import { whyUs } from "@/data/whyUs";
---

<section class="section why" id="g-why">
  <Container>
    <div class="layout">
      <div class="panel-beam chat reveal" aria-hidden="true">
        <div class="chat-top">
          <span class="avatar">
            <IconWhatsApp size={20} />
          </span>
          <strong>{site.shortName}</strong>
        </div>
        <div class="bubbles">
          <p class="bubble bubble--out">{site.whatsapp.defaultMessage}</p>
          <p class="bubble">{finalCta.text}</p>
        </div>
      </div>
      <div class="copy">
        <h2 class="metal" data-split>
          {whySection.title}
        </h2>
        <ul class="list">
          {whyUs.map((reason) => (
            <li class="reason reveal">
              <h3>{reason.title}</h3>
              <p>{reason.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>

<style>
  .layout {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .chat-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--control-md);
    height: var(--control-md);
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-400);
  }

  .bubbles {
    display: grid;
    gap: var(--space-3);
    min-height: 16rem;
    align-content: end;
    padding: var(--space-5);
  }

  .bubble {
    max-width: 85%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-brand-600);
    font-size: var(--text-sm);
  }

  .bubble--out {
    justify-self: end;
    background: var(--color-accent-100);
  }

  h2 {
    margin-bottom: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-medium);
  }

  .list {
    display: grid;
    gap: var(--space-5);
  }

  .reason {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent-500);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  p {
    margin: 0;
  }

  .reason p {
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
