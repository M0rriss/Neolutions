---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import IconCheck from "@/components/ui/icons/IconCheck.astro";

interface Props {
  servicio: CollectionEntry<"servicios">;
}

const { servicio } = Astro.props;
const { data, id } = servicio;
---

<section class="hero">
  <Container>
    <nav aria-label="Migas de pan">
      <ol class="crumbs">
        <li>
          <a href="/">Inicio</a>
        </li>
        <li>
          <a href="/servicios">Servicios</a>
        </li>
        <li aria-current="page">{data.title}</li>
      </ol>
    </nav>
    <div class="copy">
      <Badge variant="status">{data.title}</Badge>
      <h1 class="metal" data-split>
        {data.headline}
      </h1>
      <p class="text">{data.description}</p>
      <div class="actions">
        <WhatsAppButton size="lg" service={id} origen="servicio" />
        <Button variant="secondary" size="lg" href="/contacto">
          Prefiero un formulario
        </Button>
      </div>
    </div>

    <div class="panel-beam mock reveal" aria-hidden="true">
      {data.image ? (
        <Image
          src={data.image}
          alt=""
          widths={[640, 1200]}
          sizes="(min-width: 1024px) 70vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <>
          <div class="mock-top">
            <span class="mock-icon">
              <Icon name={data.icon} size={20} />
            </span>
            <strong>{data.title}</strong>
            <Badge variant="status">Disponible</Badge>
          </div>
          <ul class="mock-list">
            {data.includes.map((item) => (
              <li>
                <span class="check">
                  <IconCheck size={16} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>

    <ul class="pills reveal">
      {data.benefits.map((benefit) => (
        <li>{benefit.title}</li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + var(--space-4)) var(--space-6);
    background: var(--gradient-top-glow);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    list-style: none;
  }

  .crumbs li:not(:last-child)::after {
    content: "›";
    margin-left: var(--space-2);
  }

  .crumbs a {
    color: var(--color-text-muted);
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
  }

  .text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .actions {
    width: 100%;
    justify-content: center;
  }

  .mock {
    max-width: 62rem;
    margin: var(--space-7) auto var(--space-5);
    overflow: hidden;
  }

  .mock-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .mock-top strong {
    flex: 1;
  }

  .mock-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--control-md);
    height: var(--control-md);
    border-radius: var(--radius-sm);
    background: var(--color-field);
    color: var(--color-accent-400);
  }

  .mock-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-5);
    list-style: none;
  }

  .mock-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    background: var(--color-item);
    font-size: var(--text-sm);
  }

  .check {
    display: flex;
    color: var(--color-accent-400);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pills li {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-card-border-solid);
    border-radius: var(--radius-pill);
    background: var(--color-item);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  @media (min-width: 768px) {
    .mock-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
