---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import ParticleFigure from "@/components/ui/ParticleFigure.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { SERVICE_FIGURE } from "@/lib/motion/particleFigures";

interface Props {
  servicio: CollectionEntry<"servicios">;
}

const { servicio } = Astro.props;
const { data, id } = servicio;
---

<section class="hero">
  <Container>
    <nav aria-label="Migas de pan">
      <ol class="crumbs">
        <li>
          <a href="/">Inicio</a>
        </li>
        <li>
          <a href="/servicios">Servicios</a>
        </li>
        <li aria-current="page">{data.title}</li>
      </ol>
    </nav>
    <div class="copy">
      <Badge variant="status">{data.title}</Badge>
      <h1 class="metal" data-split>
        {data.headline}
      </h1>
      <p class="text">{data.description}</p>
      <div class="actions">
        <WhatsAppButton size="lg" service={id} origen="servicio" />
        <Button variant="secondary" size="lg" href="/contacto">
          Prefiero un formulario
        </Button>
      </div>
    </div>

    {data.image ? (
      <div class="panel-beam mock reveal" aria-hidden="true">
        <Image
          src={data.image}
          alt=""
          widths={[640, 1200]}
          sizes="(min-width: 1024px) 70vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    ) : (
      <div class="figure">
        <ParticleFigure name={SERVICE_FIGURE[id] ?? "cpu"} />
      </div>
    )}

    <ul class="pills reveal">
      {data.benefits.map((benefit) => (
        <li>{benefit.title}</li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + var(--space-4)) var(--space-6);
    background: var(--gradient-top-glow);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    list-style: none;
  }

  .crumbs li:not(:last-child)::after {
    content: "›";
    margin-left: var(--space-2);
  }

  .crumbs a {
    color: var(--color-text-muted);
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    font-size: var(--hero-title-size);
    font-weight: var(--weight-heading);
    line-height: var(--hero-title-leading);
  }

  .text {
    color: var(--color-text-muted);
    font-size: var(--hero-text-size);
  }

  .actions :global(.btn) {
    min-height: var(--hero-button-height);
    font-size: var(--hero-button-font);
  }

  .actions {
    width: 100%;
    justify-content: center;
  }

  .mock {
    width: var(--hero-frame-width);
    margin: var(--space-7) auto var(--space-5);
    overflow: hidden;
    border-width: var(--hero-frame-border);
    border-radius: var(--hero-frame-radius);
  }

  .mock img {
    width: 100%;
    height: auto;
  }

  /* Solo las partículas sobre el fondo oscuro, sin marco */
  .figure {
    height: clamp(20rem, 40vw, 36rem);
    margin-block: var(--space-5);
  }

  /* Por encima del panel: con el parallax el panel baja y las taparía */
  .pills {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pills li {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-card-border-solid);
    border-radius: var(--radius-pill);
    background: var(--color-item);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  @media (min-width: 1024px) {
    .hero :global(.container) {
      max-width: none;
    }

    .mock {
      margin-inline: calc((100% - var(--hero-frame-width)) / 2);
    }
  }
</style>
