---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["card", className]}>
  <slot />
</div>

<style>
  .card {
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-card);
    background: radial-gradient(
      68% 69% at 66% 3%,
      var(--color-card-top) 19%,
      var(--color-card-base) 73%
    );
    transition: border-color 500ms ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-accent-500) 55%, transparent);
  }

  @media (min-width: 1024px) {
    .card {
      padding: 1.6vw;
      border-radius: 1.4vw;
    }
  }
</style>
