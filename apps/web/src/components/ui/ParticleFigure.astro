---
import type { FigureName } from "@/lib/motion/particleFigures";

interface Props {
  name: FigureName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<canvas class:list={["particle-figure", className]} data-figure={name} aria-hidden="true"></canvas>

<style>
  .particle-figure {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
