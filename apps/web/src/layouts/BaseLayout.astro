---
import "@/styles/global.css";
import interUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { absoluteUrl, jsonLdString, organizationJsonLd, pageTitle } from "@/lib/seo";

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  /** Evento de carga de página: service_view o lead_submitted */
  pageEvent?: string;
  pageService?: string;
}

const {
  title,
  description,
  image = "/og-default.jpg",
  noindex = false,
  jsonLd = [],
  pageEvent,
  pageService,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = absoluteUrl(Astro.url.pathname, base);
const fullTitle = pageTitle(title);
const imageUrl = absoluteUrl(image, base);
const structured = [organizationJsonLd(base), ...jsonLd];
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Neolutions Tecnology" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#2a1b4a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {structured.map((data) => (
      <script is:inline type="application/ld+json" set:html={jsonLdString(data)} />
    ))}
  </head>
  <body data-page-event={pageEvent} data-page-service={pageService}>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
    <script>
      import { getConsent, loadAnalytics, track } from "@/lib/analytics";

      if (getConsent() === "accepted") loadAnalytics();

      const { pageEvent, pageService } = document.body.dataset;
      if (pageEvent) {
        const servicio = pageService ?? new URLSearchParams(location.search).get("servicio") ?? "";
        track(pageEvent, { servicio });
      }

      // Un solo escuchador para todos los botones de WhatsApp.
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const link = target?.closest<HTMLElement>("[data-track]");
        if (!link?.dataset.track) return;
        track(link.dataset.track, {
          origen: link.dataset.origen ?? "",
          servicio: link.dataset.servicio ?? "",
        });
      });

      const items = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
