---
import Container from "@/components/ui/Container.astro";
import { legalNav } from "@/data/navigation";
import { cleanPath } from "@/lib/seo";
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
const current = cleanPath(Astro.url.pathname);
---

<PageLayout title={title} description={description}>
  <section class="legal">
    <Container narrow>
      <nav aria-label="Migas de pan">
        <ol class="crumbs">
          <li>
            <a href="/legal">Documentos legales</a>
          </li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <h1>{title}</h1>
      <ul class="tabs">
        {legalNav.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="updated">Última actualización: {updated}</p>
      <p class="notice" role="note">
        TODO: revisar con abogado antes de publicar.
      </p>
      <div class="body">
        <slot />
      </div>
    </Container>
  </section>
</PageLayout>

<style>
  .legal {
    padding-block: var(--space-5) var(--space-8);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    list-style: none;
  }

  .crumbs li:not(:last-child)::after {
    content: "›";
    margin-left: var(--space-2);
  }

  .crumbs a {
    color: var(--color-text-muted);
  }

  h1 {
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .tabs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .tabs a[aria-current="page"] {
    background: var(--color-text);
    color: var(--color-text-on-accent);
  }

  .updated {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .notice {
    margin-block: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-warning);
    border-radius: var(--radius-md);
    background: var(--color-brand-700);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .body {
    color: var(--color-text-muted);
  }

  .body :global(h2) {
    margin-block: var(--space-6) var(--space-3);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
  }

  .body :global(p),
  .body :global(ul) {
    margin-block: var(--space-3);
  }

  .body :global(a) {
    color: var(--color-accent-400);
  }
</style>
