---
import PageHero from "@/components/sections/PageHero.astro";
import Button from "@/components/ui/Button.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="Página no encontrada"
  description="La página que buscas no existe. Vuelve al inicio o revisa nuestros servicios."
  noindex
>
  <PageHero title="No encontramos esta página" text="Puede que el enlace haya cambiado.">
    <div class="actions">
      <WhatsAppButton size="lg" origen="404" />
      <Button variant="secondary" size="lg" href="/">
        Ir al inicio
      </Button>
      <Button variant="ghost" size="lg" href="/servicios">
        Ver servicios
      </Button>
    </div>
  </PageHero>
</PageLayout>
