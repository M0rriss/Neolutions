---
import ContactForm from "@/components/islands/ContactForm";
import Card from "@/components/ui/Card.astro";
import Container from "@/components/ui/Container.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { contactPage } from "@/data/contact";
import { site } from "@/data/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { isPending, shouldShow } from "@/lib/format";
import { getServices } from "@/lib/services";

const services = (await getServices()).map((s) => ({ slug: s.id, title: s.data.title }));
---

<PageLayout title="Contacto" description={contactPage.description}>
  <section class="contact">
    <Container>
      <div class="grid">
        <div class="info">
          <h1>{contactPage.title}</h1>
          <p class="text">{contactPage.text}</p>
          <div class="actions">
            <WhatsAppButton size="lg" origen="contacto" />
          </div>
          <dl class="data">
            <div>
              <dt>WhatsApp</dt>
              <dd>{site.whatsapp.display}</dd>
            </div>
            <div>
              <dt>Zona de atención</dt>
              <dd>{site.area}</dd>
            </div>
            {shouldShow(site.schedule) && (
              <div>
                <dt>Horario</dt>
                <dd class:list={{ todo: isPending(site.schedule) }}>{site.schedule}</dd>
              </div>
            )}
            <div>
              <dt>Redes</dt>
              <dd class="social">
                <a href={site.social.tiktok} target="_blank" rel="noopener">
                  TikTok
                </a>
                <a href={site.social.facebook} target="_blank" rel="noopener">
                  Facebook
                </a>
              </dd>
            </div>
          </dl>
        </div>
        <Card>
          <ContactForm client:visible services={services} />
        </Card>
      </div>
      <p class="area">{contactPage.area}</p>
    </Container>
  </section>
</PageLayout>

<style>
  .contact {
    margin-top: calc(-1 * var(--header-height));
    padding-block: calc(var(--header-height) + var(--space-7)) var(--space-8);
    background:
      radial-gradient(50rem 30rem at 0% 0%, var(--color-accent-100), transparent 65%),
      var(--color-brand-800);
  }

  .grid {
    display: grid;
    gap: var(--space-6);
  }

  .info {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  h1 {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .data {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  dt {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  dd {
    font-weight: var(--weight-medium);
  }

  .social {
    display: flex;
    gap: var(--space-4);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
  }

  .area {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
