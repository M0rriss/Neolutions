---
import Faq from "@/components/sections/Faq.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import GlobeHold from "@/components/sections/GlobeHold.astro";
import GlobeStage from "@/components/sections/GlobeStage.astro";
import Hero from "@/components/sections/Hero.astro";
import Process from "@/components/sections/Process.astro";
import ProjectsPreview from "@/components/sections/ProjectsPreview.astro";
import ServiceGroups from "@/components/sections/ServiceGroups.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import ServicesTable from "@/components/sections/ServicesTable.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import TrustBar from "@/components/sections/TrustBar.astro";
import WhyUs from "@/components/sections/WhyUs.astro";
import { site } from "@/data/site";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title={site.tagline}
  description="Soporte técnico, redes, cámaras, páginas web, apps y sistemas a medida para pequeños negocios en Lima y Callao. Cotización gratis por WhatsApp."
>
  <GlobeStage />
  <Hero />
  <TrustBar />
  <GlobeHold />
  <ServicesGrid />
  <div id="g-table">
    <ServicesTable />
  </div>
  <ServiceGroups />
  <Process />
  <WhyUs />
  <ProjectsPreview />
  <Testimonials />
  <Faq />
  <FinalCta />
</PageLayout>
