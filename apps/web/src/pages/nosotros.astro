---
import FinalCta from "@/components/sections/FinalCta.astro";
import GlobeStage from "@/components/sections/GlobeStage.astro";
import ParticleFigure from "@/components/ui/ParticleFigure.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Process from "@/components/sections/Process.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Container from "@/components/ui/Container.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import { about } from "@/data/about";
import { serviceGroups } from "@/data/serviceGroups";
import { trustItems } from "@/data/trust";
import PageLayout from "@/layouts/PageLayout.astro";
import { isPending, shouldShow } from "@/lib/format";

const stats = trustItems.filter((item) => shouldShow(item.value));
const initials = (name: string) =>
  name
    .split(" ")
    .slice(0, 2)
    .map((word) => word[0])
    .join("");
---

<PageLayout title={about.title} description={about.description}>
  <GlobeStage />
  <PageHero
    badge={about.eyebrow}
    title={about.headline}
    text={about.intro}
  >
    <div class="actions">
      <WhatsAppButton size="lg" origen="nosotros" />
      <Button variant="secondary" size="lg" href="/servicios">
        Ver servicios
      </Button>
    </div>
    <div class="hero-figure" slot="after">
      <ParticleFigure name="network" />
    </div>
  </PageHero>

  <section class="section">
    <Container narrow>
      <div class="centered reveal">
        <SectionHeading title={about.whoHeading} align="center" />
        <p class="lead">{about.who}</p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="two reveal">
        <Card>
          <h2 class="card-title">Misión</h2>
          <p class="muted">{about.mission}</p>
        </Card>
        <Card>
          <h2 class="card-title">Visión</h2>
          <p class="muted">{about.vision}</p>
        </Card>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="reveal">
        <SectionHeading
          title="Nuestros valores"
          subtitle="Los principios que guían lo que hacemos"
          align="center"
        />
      </div>
      <ul class="cards">
        {about.values.map((value) => (
          <li class="reveal">
            <Card>
              <span class="value-icon">
                <Icon name={value.icon} size={24} />
              </span>
              <h3>{value.title}</h3>
              {shouldShow(value.text) && (
                <p class:list={["muted", { todo: isPending(value.text) }]}>{value.text}</p>
              )}
            </Card>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="reveal">
        <SectionHeading
          title="Qué hacemos"
          subtitle="Tecnología para que tu negocio no se detenga"
          align="center"
        />
      </div>
      <ul class="cards cards--three">
        {serviceGroups.map((group) => (
          <li class="reveal">
            <Card>
              <span class="value-icon">
                <Icon name={group.icon} size={24} />
              </span>
              <h3>{group.title}</h3>
              <p class="muted">{group.description}</p>
            </Card>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="reveal">
        <SectionHeading title="Qué nos hace diferentes" align="center" />
      </div>
      <dl class="stats">
        {stats.map((item) => (
          <div class:list={["reveal", { todo: isPending(item.value) }]}>
            <dd>{item.value}</dd>
            <dt>{item.label}</dt>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="reveal">
        <SectionHeading title="Nuestro equipo" align="center" />
      </div>
      <ul class="team reveal">
        {about.team.map((member) => (
          <li>
            <Card>
              <div class="member">
                {member.photo ? (
                  <img src={member.photo} alt={member.name} width="96" height="96" />
                ) : (
                  <span class="avatar" aria-hidden="true">
                    {initials(member.name)}
                  </span>
                )}
                <h3>{member.name}</h3>
                <p class="muted">{member.role}</p>
                {shouldShow(member.quote) && (
                  <p class:list={{ todo: isPending(member.quote) }}>{member.quote}</p>
                )}
              </div>
            </Card>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <Process />
  <FinalCta />
</PageLayout>

<style>
  .hero-figure {
    height: clamp(16rem, 30vw, 26rem);
    margin-top: var(--space-6);
  }

  .centered {
    text-align: center;
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .two,
  .cards {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-title {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
  }

  .value-icon {
    display: flex;
    margin-bottom: var(--space-3);
    color: var(--color-accent-400);
  }

  h3 {
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
  }

  .stats {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    text-align: center;
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
  }

  .stats dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .team {
    max-width: 24rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .member {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
  }

  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-9);
    height: var(--space-9);
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-400);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  @media (min-width: 768px) {
    .two {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    .cards--three {
      grid-template-columns: repeat(3, 1fr);
    }

    .stats {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
</style>
