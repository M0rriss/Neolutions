---
import FinalCta from "@/components/sections/FinalCta.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Process from "@/components/sections/Process.astro";
import ServiceGroups from "@/components/sections/ServiceGroups.astro";
import ServicesTable from "@/components/sections/ServicesTable.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="Servicios de tecnología"
  description="Soporte técnico, cableado, cámaras, páginas web, apps, sistemas y SEO para negocios en Lima y Callao. Cotización gratis por WhatsApp."
>
  <PageHero
    badge="7 servicios, un solo equipo"
    title="Servicios de tecnología para tu negocio"
    text="Elige lo que necesitas y te enviamos una cotización clara, sin costo."
  >
    <div class="actions">
      <WhatsAppButton size="lg" origen="servicios" />
    </div>
  </PageHero>
  <ServicesTable showAllLink={false} />
  <ServiceGroups />
  <Process />
  <FinalCta />
</PageLayout>
